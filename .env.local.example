# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Firebase CLIENT config ---
# From Firebase Console → Project Settings → General → Your apps → Web app config.
# These are safe to expose to the browser (that's what NEXT_PUBLIC_ means) — Firebase
# client keys are not secret, access control happens via Firestore security rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase ADMIN config (server-side only, keep secret) ---
# From Firebase Console → Project Settings → Service Accounts → Generate new private key.
# That downloads a JSON file. Copy the three fields below out of it.
# IMPORTANT: paste the private_key value exactly, keeping it wrapped in quotes —
# it contains literal \n characters that need to stay intact.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# Secret used to authorize the one-off scripts/seedClinic.mjs bootstrap script.
# Make up any long random string. Only needed locally, never deployed.
SETUP_SECRET=

# Convenience redirect target for /book → /book/[clinicId] in local dev.
NEXT_PUBLIC_DEFAULT_CLINIC_ID=

# --- Legacy system (ASC_current, Firebase project "appointment-booking-1f0d0") ---
# Only needed locally, to run scripts/importLegacyAppointments.mjs once. From
# that project's Firebase Console → Project Settings → Service Accounts →
# Generate new private key. Same format/caveats as FIREBASE_ADMIN_* above.
LEGACY_FIREBASE_ADMIN_PROJECT_ID=
LEGACY_FIREBASE_ADMIN_CLIENT_EMAIL=
LEGACY_FIREBASE_ADMIN_PRIVATE_KEY=""

# --- WhatsApp (Meta Cloud API) ---
# Per-clinic credentials (phone number id, access token, etc.) are entered
# in-app at /dashboard/communication and stored in Firestore, not here.
# These two are shared app-level secrets, deployed as real env vars.

# Make up any long random string yourself — this is NOT a Meta value. Paste
# the same string into Meta App Dashboard → WhatsApp → Configuration →
# Webhooks → Verify Token when subscribing the callback URL shown on the
# Communication settings page (used only for Meta's one-time GET handshake).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Authorizes app/api/cron/send-scheduled-messages (day-before/on-day
# follow-up reminders, no-show follow-ups, feedback surveys). Make up any
# long random string and set it as a real env var on Vercel — Vercel Cron
# automatically sends it as `Authorization: Bearer <value>` when this exact
# env var name is set (see vercel.json for the schedule). On another host,
# point an external scheduler at that path with the same header instead.
CRON_SECRET=

# --- Supabase Auth (replaces Firebase Auth) ---
# From Supabase Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key — safe to expose to the browser, same as the Firebase
# client config above (access control is via RLS policies + this project's
# server-side session checks, not by keeping this secret).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key — full privileged access (bypasses RLS, can create/delete
# auth users). Server-side only, never expose this one.
SUPABASE_SECRET_KEY=

# --- Postgres (Supabase) — Firestore migration, see prisma/schema.prisma ---
# From Supabase Dashboard → Project Settings → Database → Connection string.
# DATABASE_URL is the POOLED connection (port 6543, "Transaction" mode
# PgBouncer) — this is what the app uses at runtime, since a fresh
# serverless function per request would otherwise exhaust the direct
# connection limit. It needs `?pgbouncer=true` appended so Prisma disables
# prepared statements, which PgBouncer's transaction mode doesn't support.
# DIRECT_URL is the UNPOOLED connection (port 5432) — used only by
# `prisma migrate` to run schema migrations, which need a real session.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
