// Prisma schema for the Postgres (Supabase) migration off Firestore.
//
// Guiding principle for every field below: the Postgres schema uses the
// TYPE THAT IS ACTUALLY CORRECT for that data (real nullable numerics/enums
// instead of Firestore's "" sentinel, etc.). Any place that would otherwise
// force a ripple of changes through the ~50+ app/component files that
// consume this data is instead absorbed by the data-access layer we'll
// write in lib/db/ (Phase 2) — that layer is responsible for translating
// between "what Postgres correctly stores" and "the exact shape app code
// already expects" (see types/index.ts). Concretely:
//   - payment / age / follow_up / call_back: `number | ""` in TS today.
//     Stored here as nullable numerics (NULL, not ""). lib/db/ translates
//     NULL <-> "" on read/write so nothing outside lib/db/ has to change.
//   - gender / payment_type: `"...” | ""` unions today. Stored here as
//     nullable enums, same NULL <-> "" translation at the lib/db/ boundary.
//   - createdAt / clockIn / connectedAt / etc: epoch-ms `number` in TS
//     today (Firestore convention). Stored here as native `timestamptz`.
//     lib/db/ converts to/from `.getTime()` at the boundary.
//   - appointment_date / appointment_time: kept as TEXT ("YYYY-MM-DD" /
//     "HH:MM"), NOT native date/time columns. This is deliberate: large
//     amounts of existing app code do string ops on these (`.split(":")`,
//     lexicographic sort/compare, string concatenation for range checks),
//     and ISO-format text sorts and range-compares correctly in Postgres
//     anyway, so there's no functional loss — only a deferred cleanup
//     opportunity, not something to risk mid-migration.
//
// Multi-tenancy: every table that holds clinic-owned data carries
// clinic_id, mirroring the clinicId field every Firestore doc already has
// and every existing composite index already leads with. Row Level
// Security policies enforcing clinic_id isolation (the direct successor to
// firestore.rules) are deferred to the auth-migration step, since they
// depend on how clinic_id/role reach the Postgres session (custom JWT
// claims vs a joined lookup) — that decision hasn't been made yet.
//
// IDs: every table uses a native `uuid` primary key generated by Postgres
// (gen_random_uuid(), built into Postgres 13+ / enabled by default on
// Supabase), except `staff.id`, which has no default because it's meant to
// equal the auth user's id once the auth migration happens — for now it's
// assigned explicitly, same as Firebase UIDs are today.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved connection URLs out of the schema file entirely: the
// `prisma migrate`/`db push` CLI reads its connection from prisma.config.ts
// (the DIRECT, unpooled URL — migrations want a real session), and the app
// itself connects via a driver adapter passed to `new PrismaClient({
// adapter })` in lib/db/client.ts (the POOLED URL — see that file).
datasource db {
  provider = "postgresql"
}

// --- Enums ---------------------------------------------------------------

enum UserRole {
  reception
  doctor

  @@map("user_role")
}

enum AppointmentStatus {
  Booked
  Visited
  Cancelled

  @@map("appointment_status")
}

enum EntrySource {
  online
  walkin

  @@map("entry_source")
}

enum PaymentType {
  Cash
  Online

  @@map("payment_type")
}

enum AgeUnit {
  years
  months

  @@map("age_unit")
}

enum Gender {
  Male
  Female
  Other

  @@map("gender")
}

enum Shift {
  morning
  afternoon

  @@map("shift")
}

enum WhatsAppConnectionStatus {
  connected
  error

  @@map("whatsapp_connection_status")
}

enum MessageTemplateCategory {
  appointment_confirmation
  appointment_reminder
  receipt_sent
  no_show_followup
  visit_feedback
  custom

  @@map("message_template_category")
}

enum MessageDirection {
  inbound
  outbound

  @@map("message_direction")
}

enum MessageDeliveryStatus {
  queued
  sent
  delivered
  read
  failed

  @@map("message_delivery_status")
}

// --- Models ----------------------------------------------------------------

model Clinic {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  staff              Staff[]
  patients           Patient[]
  appointments       Appointment[]
  attendanceEntries  AttendanceEntry[]
  availability       AvailabilityOverride[]
  cashDeposits       CashDeposit[]
  whatsappConnection WhatsAppConnection?
  messageTemplates   MessageTemplate[]
  conversations      WhatsAppConversation[]
  auditLogs          AuditLog[]

  @@map("clinics")
}

// id has no default: it's assigned explicitly at creation time (today,
// the Firebase Auth UID; post-auth-migration, the Supabase auth.users.id).
model Staff {
  id        String   @id @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  name      String
  email     String
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")

  clinic            Clinic            @relation(fields: [clinicId], references: [id])
  attendanceEntries AttendanceEntry[]

  @@index([clinicId])
  @@map("staff")
}

// Firestore never enforced patientCode uniqueness (createPatient() just
// generates a random 6-char code with no collision check) — this
// constraint is a strict improvement, not a behavior change, but the
// create-patient code needs a retry-on-conflict added for the
// astronomically rare collision (1-in-~1.07 billion per attempt).
model Patient {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId    String   @map("clinic_id") @db.Uuid
  patientCode String   @map("patient_code") // "PT-XXXXXX"
  name        String
  phone       String
  address     String   @default("")
  age         Int?
  ageUnit     AgeUnit  @default(years) @map("age_unit")
  gender      Gender?
  createdAt   DateTime @default(now()) @map("created_at")

  // When the patient (or guardian) agreed to their data being stored and
  // processed, per the clinic's privacy notice. NULL = not recorded
  // (records created before consent capture existed).
  dataConsentAt DateTime? @map("data_consent_at")

  clinic        Clinic                 @relation(fields: [clinicId], references: [id])
  appointments  Appointment[]
  conversations WhatsAppConversation[]

  @@unique([clinicId, patientCode])
  @@index([clinicId, createdAt(sort: Desc)])
  @@index([clinicId, phone])
  @@index([clinicId, name])
  @@map("patients")
}

model Appointment {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId        String            @map("clinic_id") @db.Uuid
  appointmentDate String            @map("appointment_date") // "YYYY-MM-DD" — see header note
  appointmentTime String            @map("appointment_time") // "HH:MM" 24h — see header note
  status          AppointmentStatus
  entrySource     EntrySource       @map("entry_source")
  tokenNumber     Int               @map("token_number")
  shift           Shift

  // Denormalized patient snapshot at booking time, same as Firestore today
  // (patientId is a soft link, nullable — online bookings and legacy rows
  // aren't always linked to a Patient record).
  patientId      String? @map("patient_id") @db.Uuid
  patientName    String  @map("patient_name")
  patientPhone   String  @map("patient_phone")
  patientAddress String  @default("") @map("patient_address")
  age            Int?
  ageUnit        AgeUnit @default(years) @map("age_unit")
  gender         Gender?

  payment     Decimal?     @db.Decimal(10, 2)
  paymentType PaymentType? @map("payment_type")
  reference   String       @default("")

  diagnosis String @default("")

  followUp              Int?    @map("follow_up")
  followUpSent          Boolean @default(false) @map("follow_up_sent")
  followUpDayBeforeSent Boolean @default(false) @map("follow_up_day_before_sent")

  callBack            Int?      @map("call_back")
  callBackDueDate     String?   @map("call_back_due_date") // "YYYY-MM-DD", same reasoning as appointmentDate
  callBackCompletedAt String? @map("call_back_completed_at") // "YYYY-MM-DD" — same reasoning as appointmentDate

  // Guards for app/api/cron/send-scheduled-messages — each fires at most
  // once per appointment.
  receiptSent  Boolean @default(false) @map("receipt_sent")
  noShowSent   Boolean @default(false) @map("no_show_sent")
  feedbackSent Boolean @default(false) @map("feedback_sent")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @map("created_by") @db.Uuid

  // Consent captured on the appointment itself — online bookings have no
  // Patient record to hold it.
  dataConsentAt DateTime? @map("data_consent_at")

  clinic  Clinic   @relation(fields: [clinicId], references: [id])
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([clinicId, appointmentDate, appointmentTime])
  @@index([clinicId, appointmentDate])
  @@index([clinicId, patientPhone, createdAt(sort: Desc)])
  @@index([clinicId, callBackDueDate])
  @@index([clinicId, patientId])
  @@map("appointments")
}

// Clock-in only (no clock-out), same as today — one entry per staff member
// per day, enforced here as a real constraint (Firestore relied on
// application code alone to keep it that way).
model AttendanceEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  staffUid  String   @map("staff_uid") @db.Uuid
  staffName String   @map("staff_name")
  date      String // "YYYY-MM-DD"
  clockIn   DateTime @map("clock_in")

  clinic Clinic @relation(fields: [clinicId], references: [id])
  staff  Staff  @relation(fields: [staffUid], references: [id])

  @@unique([staffUid, date])
  @@index([clinicId, date(sort: Desc)])
  @@map("attendance")
}

// One row per (clinic, date) override — was doc id `${clinicId}_${date}`
// in Firestore; the composite unique constraint replaces that encoding.
model AvailabilityOverride {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId     String   @map("clinic_id") @db.Uuid
  date         String // "YYYY-MM-DD"
  unavailable  Boolean  @default(false)
  morningStart String   @default("") @map("morning_start") // "" means that shift is closed this date
  morningEnd   String   @default("") @map("morning_end")
  eveningStart String   @default("") @map("evening_start")
  eveningEnd   String   @default("") @map("evening_end")
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedBy    String   @map("updated_by") @db.Uuid

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, date])
  @@map("availability")
}

// One row per (clinic, month) — was doc id `${clinicId}_${period}` in
// Firestore. "Cash on hand" stays derived (monthly cash revenue - amount),
// never stored, so it can't drift.
model CashDeposit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId  String   @map("clinic_id") @db.Uuid
  period    String // "YYYY-MM"
  amount    Decimal  @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @map("updated_by") @db.Uuid

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, period])
  @@map("cash_deposits")
}

// One row per clinic (was doc id == clinicId in Firestore) — hence
// clinicId itself is the primary key here, a straightforward 1:1.
// accessToken/appSecret are Meta credentials: this table is never exposed
// to a client query, server-side data-access only, same as today.
model WhatsAppConnection {
  clinicId      String                   @id @map("clinic_id") @db.Uuid
  status        WhatsAppConnectionStatus
  phoneNumberId String                   @map("phone_number_id")
  accessToken   String                   @map("access_token")
  appSecret     String                   @map("app_secret")
  wabaId        String                   @map("waba_id")
  phoneNumber   String                   @map("phone_number")
  connectedAt   DateTime                 @map("connected_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  lastError     String?                  @map("last_error")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@map("whatsapp_connections")
}

model MessageTemplate {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId       String                  @map("clinic_id") @db.Uuid
  name           String // must exactly match the template name approved in Meta
  category       MessageTemplateCategory
  language       String // Meta language code, e.g. "en", "en_US"
  variableLabels String[]                @map("variable_labels") // for "custom"; fixed categories use TEMPLATE_VARIABLE_LABELS in app code
  bodyPreview    String                  @map("body_preview")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  clinic   Clinic            @relation(fields: [clinicId], references: [id])
  messages WhatsAppMessage[]

  @@index([clinicId])
  @@map("message_templates")
}

// One per (clinic, phone number) — was doc id
// `${clinicId}_${normalizedPhone}` in Firestore. This table (and
// WhatsAppMessage below) is read live via Supabase Realtime from the
// browser once that piece of the migration lands — see the Inbox
// discussion; RLS on these two tables is what stands in for
// firestore.rules' client-read protection.
model WhatsAppConversation {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId           String   @map("clinic_id") @db.Uuid
  patientId          String?  @map("patient_id") @db.Uuid // best-effort link by phone, not required
  patientName        String?  @map("patient_name") // denormalized snapshot for display
  phoneNumber        String   @map("phone_number")
  lastMessagePreview String   @default("") @map("last_message_preview")
  lastMessageAt      DateTime @map("last_message_at")
  unreadCount        Int      @default(0) @map("unread_count")
  // Set when the patient replies STOP; automated sends skip opted-out
  // numbers until they reply START.
  optedOut           Boolean  @default(false) @map("opted_out")
  updatedAt          DateTime @updatedAt @map("updated_at")

  clinic   Clinic            @relation(fields: [clinicId], references: [id])
  patient  Patient?          @relation(fields: [patientId], references: [id], onDelete: SetNull)
  messages WhatsAppMessage[]

  @@unique([clinicId, phoneNumber])
  @@index([clinicId, lastMessageAt(sort: Desc)])
  @@map("whatsapp_conversations")
}

// Was the `messages` subcollection of its conversation doc — Postgres has
// no subcollections, so this becomes its own table with a conversationId
// foreign key.
model WhatsAppMessage {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId          String                @map("clinic_id") @db.Uuid
  conversationId    String                @map("conversation_id") @db.Uuid
  direction         MessageDirection
  body              String
  status            MessageDeliveryStatus
  templateId        String?               @map("template_id") @db.Uuid
  providerMessageId String?               @map("provider_message_id")
  createdAt         DateTime              @default(now()) @map("created_at")

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  template     MessageTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt(sort: Asc)])
  @@index([clinicId])
  @@map("whatsapp_messages")
}

// Append-only record of who did what to which record. Backs CERT-In's
// log-retention requirement and DPDP breach scoping ("who touched this
// patient's data, and when"). Never updated or deleted by the app; rows
// are written best-effort by lib/db/auditLog.ts so a logging failure can
// never block patient care. actorName is a denormalized snapshot (the
// email at the time) so the trail survives staff removal.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId   String   @map("clinic_id") @db.Uuid
  actorUid   String   @map("actor_uid") @db.Uuid
  actorName  String   @map("actor_name")
  actorRole  UserRole @map("actor_role")
  action     String // e.g. "patient.view", "appointment.update", "staff.remove"
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, createdAt(sort: Desc)])
  @@index([clinicId, targetType, targetId])
  @@map("audit_logs")
}

// Fixed-window counters for abuse protection on unauthenticated endpoints
// (public booking, signup, login). One row per attempt; lib/rateLimit.ts
// counts rows in the window and prunes old ones. `key` is an IP or email —
// operational data only, never patient data.
model RateLimitEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucket    String
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([bucket, key, createdAt])
  @@index([createdAt])
  @@map("rate_limit_events")
}
